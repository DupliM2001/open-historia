# Android build (the app: this same web bundle inside a Capacitor WebView).
# Loaded ONLY by `vite build --mode android` (npm run build:android).
#
# Everything the game needs is on the phone: the library lives in IndexedDB, and
# the world map — the three pmtiles archives, the regions GeoJSON and the editor
# seeds — ships inside the APK under /assets (mobile/scripts/stage-www.mjs), so
# VITE_OH_PMTILES_URL is deliberately UNSET here: the interceptor's /assets
# fallback is the bundled copy, and there is no node directory to consult.
VITE_OH_WEB=1
VITE_OH_NATIVE=1

# The one network service this build is configured with: the community hub,
# opt-in from inside the game (GitHub-hosted scenarios need the SSRF-guarded
# proxy, since GitHub sends no CORS headers). It is not the only thing that
# uses the network: so do the player's AI provider, the update check, map
# tiles, flag pictures, place search and the setup video on a click
# (docs/mobile.md).
VITE_OH_HUB_URL=https://open-historia-registry.nichojkrol.workers.dev
